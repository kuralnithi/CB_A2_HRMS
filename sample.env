# ==============================================================================
# AI HRMS Copilot - Backend Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# Backend Service Configuration
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-change-in-production"

# PostgreSQL Configuration (For Local Docker or Native Setup)
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="hr_copilot"
POSTGRES_PORT="5432"

# Primary Database Connection URL
# For Local PostgreSQL: postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/hr_copilot
# For Neon PostgreSQL: postgresql+asyncpg://<user>:<password>@<neon-host>/neondb?sslmode=require
DATABASE_URL="postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/hr_copilot"

# Large Language Models (LLMs) API Keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
GEMINI_API_KEY="AIzaSy_your_gemini_api_key_here"

# Vector Database (Qdrant Cloud or Local)
# URL to your Qdrant cluster (e.g. cloud URL or http://localhost:6333)
QDRANT_URL="https://your-qdrant-cluster-url.aws.cloud.qdrant.io"
QDRANT_API_KEY="your_qdrant_api_key_here"

# Redis Cache & Session Store
# For Local Redis: redis://localhost:6379/0
# For Upstash/Redis Cloud: redis://:<password>@<host>:<port>
REDIS_URL="redis://localhost:6379/0"
